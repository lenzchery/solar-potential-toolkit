# Copy this file to env/.env (same folder, filename ".env") and fill in
# your local PostgreSQL/PostGIS credentials. env/.env is gitignored and
# must NEVER be committed - this file (env/.env.example) is the one
# tracked in the repository. Used by utils/database.py via python-dotenv,
# loaded from an explicit path (see PROJECT_ROOT / "env" / ".env" there).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=solar